# Flask
# SECRET_KEYは `python -c "import secrets; print(secrets.token_hex(32))"` などで生成する
SECRET_KEY=
FLASK_ENV=development
APP_BASE_URL=http://localhost:5000

# Google OAuth 2.0 (Google Cloud Consoleで発行)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Google Forms push notifications (Cloud Pub/Sub)
# 例: projects/your-project-id/topics/google-forms-responses
GOOGLE_FORMS_PUBSUB_TOPIC=
# Pub/Sub push subscription URLに ?token=... として付ける共有トークン
GOOGLE_FORMS_PUBSUB_PUSH_TOKEN=

# モックモード(trueにするとGoogle API・Firebaseへ接続せずダミーデータで動作)
MOCK_MODE=false

# セッションCookie(ローカル開発ではSESSION_COOKIE_SECURE=falseにする)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
